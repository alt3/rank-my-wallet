{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    // `baseUrl` is deprecated in TypeScript 6 and stops working in 7. The
    // root-relative `src/...` and `test/...` specifiers it used to resolve are
    // spelled out here instead; without a `baseUrl` these are resolved
    // relative to this file.
    "paths": {
      "@/components/*": ["./src/components/*"],
      "src/*": ["./src/*"],
      "test/*": ["./test/*"]
    }
  },
  "exclude": ["node_modules", "**/*.e2e.ts", "cypress"],
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "types", "vitest.config.mts"]
}
